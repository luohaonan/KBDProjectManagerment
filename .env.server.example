# 复制为 .env.server 后填写真实值；不要提交到 Git，也不要打包进镜像。
# PowerShell 可用：Copy-Item .env.server.example .env.server

COMPOSE_PROJECT_NAME=kbd-pms
DOCKER_IMAGE_PREFIX=kbd-pms
IMAGE_TAG=latest

DB_NAME=kbd_pm_system
DB_USER=kbd_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# 至少 32 位随机字符串，建议使用：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_LONG_SECRET
JWT_EXPIRATION=86400000